-  resetRooms: () => void;
-}
-
-export const useRoomsStore = create<RoomsState>()(
-  persist(
-    (set) => ({
-      joinedRooms: [],
-      activeRoom: null,
-
-      joinRoom: (room) =>
-        set((state) =>
-          state.joinedRooms.includes(room)
-            ? state
-            : { joinedRooms: [...state.joinedRooms, room] },
-        ),
-
-      selectRoom: (room) =>
